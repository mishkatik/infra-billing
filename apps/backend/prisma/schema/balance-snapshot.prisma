model BalanceSnapshot {
  id BigInt @id @default(autoincrement()) @map("id")

  accountUuid String   @map("account_uuid")
  balance     Decimal  @map("balance") @db.Decimal(14, 2)
  currency    String   @map("currency")
  capturedAt  DateTime @default(now()) @map("captured_at")

  account ProviderAccount @relation(fields: [accountUuid], references: [uuid], onDelete: Cascade)

  @@index([accountUuid, capturedAt], map: "balance_snapshots_account_captured_idx")
  @@map("balance_snapshots")
}
