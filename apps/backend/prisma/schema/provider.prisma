// The hoster identity (name, kind, cabinet link, icon). See ProviderAccount for the rest.
model Provider {
  uuid String @id @default(uuid()) @map("uuid")

  name        String  @map("name")
  kind        String  @map("kind")
  faviconLink String? @map("favicon_link")
  loginUrl    String? @map("login_url")
  iconName    String? @map("icon_name")
  iconBg      String? @map("icon_bg")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Credentials, balance and sync state live on the accounts.
  accounts ProviderAccount[]

  @@map("providers")
}
