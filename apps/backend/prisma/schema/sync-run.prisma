model SyncRun {
  id BigInt @id @default(autoincrement()) @map("id")

  accountUuid   String    @map("account_uuid")
  status        String    @map("status")
  servicesFound Int       @default(0) @map("services_found")
  error         String?   @map("error")
  startedAt     DateTime  @default(now()) @map("started_at")
  finishedAt    DateTime? @map("finished_at")

  account ProviderAccount @relation(fields: [accountUuid], references: [uuid], onDelete: Cascade)

  @@index([accountUuid, startedAt], map: "sync_runs_account_started_idx")
  @@map("sync_runs")
}
